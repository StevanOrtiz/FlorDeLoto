# Copia este archivo como .env (nunca subas .env al repositorio).
# Las variables sin el prefijo PUBLIC_ son solo de servidor: no llegan al navegador.

# Cadena de conexión de Neon (Postgres). Cópiala de la consola de Neon: Connection details → «Pooled connection».
DATABASE_URL=

# Cloudflare Turnstile (anti-spam del formulario; opcional pero recomendado).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Código de verificación de Google Search Console (opcional).
PUBLIC_GSC_VERIFICATION=

# La cuenta de administrador NO se configura aquí. Se crea una vez desde la terminal:
#   ADMIN_EMAIL=correo@ejemplo.com ADMIN_PASSWORD='una contraseña larga' npm run admin:create
