# Copia este archivo como .env (nunca subas .env al repositorio).
# Variables solo de servidor: no llevan el prefijo PUBLIC_, no llegan al navegador.

# Supabase (fase siguiente): guarda los mensajes del formulario.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (anti-spam). Clave pública del widget y secreta del servidor.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
