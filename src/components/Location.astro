---
import Icon from './Icon.astro';
import MapEmbed from './MapEmbed.astro';
import { business, fullAddress } from '../lib/site';
interface Props { heading?: 'h1' | 'h2' }
const { heading = 'h2' } = Astro.props;
const H = heading;
---
<section class="loc section" id="donde-estamos" aria-labelledby="loc-title">
  <div class="container loc__grid">
    <div class="loc__info">
      <p class="eyebrow" data-reveal="up">Dónde estamos</p>
      <H id="loc-title" class="h2" data-split>Te esperamos en <em>el corazón de Segovia</em></H>
      <ul class="loc__list" data-stagger>
        <li>
          <Icon name="pin" />
          <div>
            <strong>Dirección</strong>
            <a href={business.maps} target="_blank" rel="noopener">{fullAddress}</a>
          </div>
        </li>
        <li>
          <Icon name="phone" />
          <div>
            <strong>Teléfono y WhatsApp</strong>
            <a href={business.phoneHref}>{business.phone}</a>
          </div>
        </li>
        {business.email && (
          <li>
            <Icon name="mail" />
            <div><strong>Correo</strong><a href={`mailto:${business.email}`}>{business.email}</a></div>
          </li>
        )}
        <li>
          <Icon name="clock" />
          <div>
            <strong>Horario de tienda</strong>
            <dl class="loc__hours">
              {business.hours.store.map((h) => (<><dt>{h.days}</dt><dd>{h.open ? `${h.open}–${h.close}` : h.label}</dd></>))}
            </dl>
            <strong class="loc__sub">Pedidos y atención en línea</strong>
            <dl class="loc__hours">
              {business.hours.online.map((h) => (<><dt>{h.days}</dt><dd>{`${h.open}–${h.close}`}</dd></>))}
            </dl>
            <p class="loc__note">En festivos y fechas señaladas, llámanos para confirmar el horario.</p>
          </div>
        </li>
        <li>
          <Icon name="accessible" />
          <div>
            <strong>Servicios</strong>
            <span>{business.amenities.join(' · ')}</span>
          </div>
        </li>
      </ul>
    </div>
    <div class="loc__map" data-reveal="scale">
      <MapEmbed />
    </div>
  </div>
</section>

<style>
  .loc__grid { display: grid; gap: clamp(32px, 5vw, 72px); }
  @media (min-width: 960px) { .loc__grid { grid-template-columns: 1fr 1.1fr; align-items: stretch; } }
  .loc__info { display: grid; gap: 18px; align-content: start; }
  .loc__info h2, .loc__info h1 { max-width: 14ch; }
  .loc__info :global(em) { color: var(--wine); }
  .loc__list { list-style: none; padding: 0; display: grid; gap: 22px; margin-top: 12px; }
  .loc__list li { display: grid; grid-template-columns: 28px 1fr; gap: 14px; }
  .loc__list li > svg { color: var(--wine); margin-top: 2px; }
  .loc__list strong { display: block; font-weight: 600; margin-bottom: 2px; }
  .loc__list a { text-decoration: none; }
  .loc__list a:hover { color: var(--wine); text-decoration: underline; }
  .loc__sub { margin-top: 14px; }
  .loc__hours { display: grid; grid-template-columns: auto auto; justify-content: start; gap: 2px 24px; color: var(--ink-soft); font-size: var(--fs-sm); }
  .loc__hours dd { margin: 0; }
  .loc__note { font-size: var(--fs-xs); color: var(--ink-soft); margin-top: 8px; }
  .loc__map { min-height: 420px; }
</style>
