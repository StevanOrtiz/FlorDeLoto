---
import Icon from './Icon.astro';
import { business, waLink } from '../lib/site';
interface Props { title?: string; compact?: boolean }
const { title = 'Haz tu pedido como prefieras', compact = false } = Astro.props;
---
<section class:list={['order', { section: !compact }]} id="como-pedir" aria-labelledby="order-title">
  <div class="container">
    <div class="order__head">
      <p class="eyebrow" data-reveal="up">Cómo pedir</p>
      <h2 id="order-title" class="h2" data-split>{title}</h2>
    </div>
    <div class="order__grid" data-stagger>
      <a class="ocard ocard--main" href={waLink('¡Hola! Me gustaría hacer un pedido.')} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={34} />
        <span class="ocard__name">WhatsApp</span>
        <span class="ocard__note">La forma más rápida. Cuéntanos qué buscas, para quién y cuándo.</span>
        <span class="ocard__go">Escribir ahora <Icon name="arrow" size={16} /></span>
      </a>
      <a class="ocard" href={business.phoneHref}>
        <Icon name="phone" size={30} />
        <span class="ocard__name">Por teléfono</span>
        <span class="ocard__note">{business.phone}</span>
        <span class="ocard__go">Llamar <Icon name="arrow" size={16} /></span>
      </a>
      <a class="ocard" href={business.maps} target="_blank" rel="noopener">
        <Icon name="pin" size={30} />
        <span class="ocard__name">En la tienda</span>
        <span class="ocard__note">{business.address.street}, Segovia</span>
        <span class="ocard__go">Cómo llegar <Icon name="arrow" size={16} /></span>
      </a>
      {business.channels.map((c) => (
        <a class="ocard ocard--small" href={c.url} target="_blank" rel="noopener">
          <Icon name="bag" size={26} />
          <span class="ocard__name">{c.name}</span>
          <span class="ocard__note">{c.note}</span>
          <span class="ocard__go">Abrir <Icon name="external" size={14} /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .order__head { margin-bottom: clamp(32px, 5vw, 56px); display: grid; gap: 14px; }
  .order__grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); }
  .ocard { position: relative; display: grid; gap: 8px; align-content: start; padding: 26px; border-radius: var(--radius); background: var(--white); text-decoration: none; border: 1px solid var(--line); overflow: hidden; isolation: isolate; transition: transform 0.6s var(--ease), border-color 0.3s, color 0.3s; }
  .ocard::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--blush-50); transform: scaleY(0); transform-origin: bottom; transition: transform 0.6s var(--ease); }
  .ocard:hover { transform: translateY(-4px); border-color: transparent; }
  .ocard:hover::before { transform: scaleY(1); }
  .ocard svg:first-child { color: var(--wine); }
  .ocard__name { font-family: var(--font-serif); font-size: 1.45rem; margin-top: 6px; }
  .ocard__note { color: var(--ink-soft); font-size: var(--fs-sm); }
  .ocard__go { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: var(--fs-sm); color: var(--wine); margin-top: 8px; }
  .ocard--main { background: #1f7a4d; color: var(--white); border-color: transparent; }
  @media (min-width: 900px) {
    .order__grid { grid-template-columns: 1.2fr repeat(3, 1fr); }
    .ocard--main { grid-row: span 2; align-content: end; }
  }
  .ocard--main::before { background: #17603c; }
  .ocard--main svg:first-child, .ocard--main .ocard__go { color: var(--white); }
  .ocard--main .ocard__note { color: var(--white); }
  .ocard--main .ocard__name { font-size: 2rem; }
  .ocard--small .ocard__name { font-size: 1.2rem; }
</style>
