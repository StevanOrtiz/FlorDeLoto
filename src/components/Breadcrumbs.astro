---
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Ruta de navegación" class="crumbs">
  <ol>
    {items.map((c, i) => (
      <li>
        {i < items.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; font-size: var(--fs-xs); color: var(--ink-soft); }
  .crumbs li + li::before { content: '/'; margin-right: 6px; opacity: 0.5; }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--wine); text-decoration: underline; }
</style>
