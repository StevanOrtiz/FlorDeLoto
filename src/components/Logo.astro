---
// Logo oficial de Flor de Loto Segovia (PNG recortado a WebP con fondo transparente).
interface Props { class?: string; light?: boolean }
const { class: cls, light = false } = Astro.props;
const src = light ? '/img/brand/logo-light.webp' : '/img/brand/logo.webp';
---
<span class:list={['logo', cls, { 'logo--light': light }]}>
  <img class="logo__img" src={src} width="640" height="654" alt="Flor de Loto Segovia" decoding="async" />
</span>

<style>
  .logo { display: inline-flex; align-items: center; }
  .logo__img { height: 62px; width: auto; display: block; transition: transform 0.8s var(--ease); }
  .logo--light .logo__img { height: 120px; }
  :global(a:hover) > .logo .logo__img { transform: scale(1.04); }
  @media (max-width: 600px) { .logo__img { height: 52px; } }
</style>
